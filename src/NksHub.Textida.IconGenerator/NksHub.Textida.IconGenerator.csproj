<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <!-- the generator ships inside this repository only, so there is no released-rules file to keep -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System" />
    <Using Include="System.Collections.Generic" />
    <Using Include="System.IO" />
    <Using Include="System.Linq" />
  </ItemGroup>

  <ItemGroup>
    <!-- the icons of the program are read by the very reader that checks the icons of a plugin, so a file that one accepts the other accepts too -->
    <Compile Include="..\NksHub.Textida.Workbench\Icons\SvgIcon.cs" Link="SvgIcon.cs" />
    <Compile Include="..\NksHub.Textida.Workbench\Icons\IconShape.cs" Link="IconShape.cs" />
  </ItemGroup>

</Project>
