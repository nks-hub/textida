<Project>
  <!--
    The projects of the product are built optimized in a debug build too. The latency gates of the Perf category run on a debug build, and its unoptimized
    code is several times slower than what ships (AOT): typing at 1000 carets measured 35-38 ms (p95) that way and 29-32 ms optimized, on the same machine.
    The tests are not affected. To step through the product in a debugger, build with -p:Optimize=false.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>true</Optimize>
  </PropertyGroup>
</Project>
