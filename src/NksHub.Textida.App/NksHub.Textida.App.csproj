<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Textida</AssemblyName>
    <RootNamespace>NksHub.Textida.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <!-- NativeAOT from the start; the analyzers run on every build of own code -->
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <OptimizationPreference>Speed</OptimizationPreference>
    <StripSymbols>true</StripSymbols>
    <AppleMinOSVersion>14.0</AppleMinOSVersion>
    <!-- Trim and AOT warnings in own code are errors. Third-party assemblies collapse to IL2104/IL3053 (TrimmerSingleWarn); see docs/p0/aot-zavislosti.md. -->
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2032;IL2055;IL2057;IL2058;IL2059;IL2060;IL2061;IL2062;IL2063;IL2064;IL2065;IL2066;IL2067;IL2068;IL2069;IL2070;IL2071;IL2072;IL2073;IL2074;IL2075;IL2076;IL2077;IL2078;IL2079;IL2080;IL2081;IL2082;IL2083;IL2084;IL2085;IL2086;IL2087;IL2088;IL2089;IL2090;IL2091;IL3050;IL3051;IL3052</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Strings\*.json" />
    <!-- help.cs.md would be taken for a satellite resource of the culture "cs" -->
    <EmbeddedResource Include="Help\*.md" LogicalName="NksHub.Textida.App.Help.%(Filename)%(Extension)" WithCulture="false" />
    <ProjectReference Include="..\NksHub.Textida.Core\NksHub.Textida.Core.csproj" />
    <ProjectReference Include="..\NksHub.Textida.Workbench\NksHub.Textida.Workbench.csproj" />
    <ProjectReference Include="..\NksHub.Textida.Accessibility\NksHub.Textida.Accessibility.csproj" />
    <ProjectReference Include="..\NksHub.Textida.PluginHost\NksHub.Textida.PluginHost.csproj" />
    <ProjectReference Include="..\NksHub.Textida.Remote\NksHub.Textida.Remote.csproj" />
    <ProjectReference Include="..\NksHub.Textida.McpClient\NksHub.Textida.McpClient.csproj" />
    <!-- the built-in JSON formatter runs as its own process; it is built first and copied next to the app -->
    <ProjectReference Include="..\NksHub.Textida.Plugins.Json\NksHub.Textida.Plugins.Json.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\NksHub.Textida.Plugins.TextTools\NksHub.Textida.Plugins.TextTools.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\NksHub.Textida.Plugins.WebData\NksHub.Textida.Plugins.WebData.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\NksHub.Textida.Plugins.CodeExplorer\NksHub.Textida.Plugins.CodeExplorer.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\NksHub.Textida.Plugins.Emmet\NksHub.Textida.Plugins.Emmet.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\NksHub.Textida.Plugins.Formatters\NksHub.Textida.Plugins.Formatters.csproj" ReferenceOutputAssembly="false" />
    <!-- the program an MCP client starts; it is built first and copied next to the app -->
    <ProjectReference Include="..\NksHub.Textida.Mcp\NksHub.Textida.Mcp.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\NksHub.Textida.Document.AvaloniaEdit\NksHub.Textida.Document.AvaloniaEdit.csproj" />
    <InternalsVisibleTo Include="NksHub.Textida.App.Tests" />
  </ItemGroup>

  <Target Name="CopyBuiltInPlugins" AfterTargets="Build">
    <ItemGroup>
      <JsonPluginFiles Include="..\NksHub.Textida.Plugins.Json\bin\$(Configuration)\$(TargetFramework)\**\*" />
      <TextToolsPluginFiles Include="..\NksHub.Textida.Plugins.TextTools\bin\$(Configuration)\$(TargetFramework)\**\*" />
      <WebDataPluginFiles Include="..\NksHub.Textida.Plugins.WebData\bin\$(Configuration)\$(TargetFramework)\**\*" />
      <CodeExplorerPluginFiles Include="..\NksHub.Textida.Plugins.CodeExplorer\bin\$(Configuration)\$(TargetFramework)\**\*" />
      <EmmetPluginFiles Include="..\NksHub.Textida.Plugins.Emmet\bin\$(Configuration)\$(TargetFramework)\**\*" />
      <FormattersPluginFiles Include="..\NksHub.Textida.Plugins.Formatters\bin\$(Configuration)\$(TargetFramework)\**\*" />
      <McpBridgeFiles Include="..\NksHub.Textida.Mcp\bin\$(Configuration)\$(TargetFramework)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(JsonPluginFiles)" DestinationFiles="@(JsonPluginFiles->'$(OutDir)plugins\json\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(TextToolsPluginFiles)" DestinationFiles="@(TextToolsPluginFiles->'$(OutDir)plugins\texttools\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(WebDataPluginFiles)" DestinationFiles="@(WebDataPluginFiles->'$(OutDir)plugins\webdata\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CodeExplorerPluginFiles)" DestinationFiles="@(CodeExplorerPluginFiles->'$(OutDir)plugins\codeexplorer\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(EmmetPluginFiles)" DestinationFiles="@(EmmetPluginFiles->'$(OutDir)plugins\emmet\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(FormattersPluginFiles)" DestinationFiles="@(FormattersPluginFiles->'$(OutDir)plugins\formatters\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(McpBridgeFiles)" DestinationFiles="@(McpBridgeFiles->'$(OutDir)mcp\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
