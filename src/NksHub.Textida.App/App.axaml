<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="NksHub.Textida.App.App"
             RequestedThemeVariant="Default">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="Bg0">#EEF0F3</SolidColorBrush>
                    <SolidColorBrush x:Key="Bg1">#F5F6F8</SolidColorBrush>
                    <SolidColorBrush x:Key="BgEditor">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="BgHover">#E6E9EE</SolidColorBrush>
                    <SolidColorBrush x:Key="Border">#DCDFE4</SolidColorBrush>
                    <SolidColorBrush x:Key="Fg">#1B1D21</SolidColorBrush>
                    <SolidColorBrush x:Key="FgMuted">#565B64</SolidColorBrush>
                    <SolidColorBrush x:Key="Accent">#0F7B6C</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFg">#FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="SelectedFg">#1B1D21</SolidColorBrush>
                    <SolidColorBrush x:Key="LineNumbers">#8A9099</SolidColorBrush>
                    <SolidColorBrush x:Key="EditorFg">#1B1D21</SolidColorBrush>
                    <SolidColorBrush x:Key="ChromeBg">#EEF0F3</SolidColorBrush>
                    <SolidColorBrush x:Key="TabRowBg">#E3E7EC</SolidColorBrush>
                    <SolidColorBrush x:Key="TabBg">#ECEFF2</SolidColorBrush>
                    <SolidColorBrush x:Key="TabHoverBg">#F5F7F9</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSoft">#D8EDE9</SolidColorBrush>
                    <SolidColorBrush x:Key="Scrim">#26000000</SolidColorBrush>
                    <SolidColorBrush x:Key="Highlight">#99FFD866</SolidColorBrush>
                    <SolidColorBrush x:Key="CurrentLine">#F1F4F8</SolidColorBrush>
                    <SolidColorBrush x:Key="BracketMatch">#D3DAE3</SolidColorBrush>
                    <SolidColorBrush x:Key="SelectionBg">#3D0F7B6C</SolidColorBrush>
                    <SolidColorBrush x:Key="InfoBg">#E8F1EF</SolidColorBrush>
                    <SolidColorBrush x:Key="WarnBg">#FFF4D6</SolidColorBrush>
                    <SolidColorBrush x:Key="DiffRemoved">#FFD5D2</SolidColorBrush>
                    <SolidColorBrush x:Key="DiffAdded">#C9EBCF</SolidColorBrush>
                    <SolidColorBrush x:Key="Danger">#B3261E</SolidColorBrush>
                    <SolidColorBrush x:Key="Good">#1B6E3A</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="Bg0">#202225</SolidColorBrush>
                    <SolidColorBrush x:Key="Bg1">#2A2C30</SolidColorBrush>
                    <SolidColorBrush x:Key="BgEditor">#1F1F1F</SolidColorBrush>
                    <SolidColorBrush x:Key="BgHover">#34373C</SolidColorBrush>
                    <SolidColorBrush x:Key="Border">#3C3F45</SolidColorBrush>
                    <SolidColorBrush x:Key="Fg">#E6E8EB</SolidColorBrush>
                    <SolidColorBrush x:Key="FgMuted">#A9AEB7</SolidColorBrush>
                    <SolidColorBrush x:Key="Accent">#3DC2AC</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentFg">#00201A</SolidColorBrush>
                    <SolidColorBrush x:Key="SelectedFg">#E6E8EB</SolidColorBrush>
                    <SolidColorBrush x:Key="LineNumbers">#6F7681</SolidColorBrush>
                    <SolidColorBrush x:Key="EditorFg">#D4D7DC</SolidColorBrush>
                    <SolidColorBrush x:Key="ChromeBg">#202225</SolidColorBrush>
                    <SolidColorBrush x:Key="TabRowBg">#2A2C31</SolidColorBrush>
                    <SolidColorBrush x:Key="TabBg">#33363B</SolidColorBrush>
                    <SolidColorBrush x:Key="TabHoverBg">#3B3E44</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentSoft">#1F4A43</SolidColorBrush>
                    <SolidColorBrush x:Key="Scrim">#4D000000</SolidColorBrush>
                    <SolidColorBrush x:Key="Highlight">#80B38A00</SolidColorBrush>
                    <SolidColorBrush x:Key="CurrentLine">#25272B</SolidColorBrush>
                    <SolidColorBrush x:Key="BracketMatch">#454B53</SolidColorBrush>
                    <SolidColorBrush x:Key="SelectionBg">#553DC2AC</SolidColorBrush>
                    <SolidColorBrush x:Key="InfoBg">#26322F</SolidColorBrush>
                    <SolidColorBrush x:Key="WarnBg">#40361A</SolidColorBrush>
                    <SolidColorBrush x:Key="DiffRemoved">#5E2B2B</SolidColorBrush>
                    <SolidColorBrush x:Key="DiffAdded">#27502F</SolidColorBrush>
                    <SolidColorBrush x:Key="Danger">#FF8A80</SolidColorBrush>
                    <SolidColorBrush x:Key="Good">#7FD99A</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme>
            <FluentTheme.Palettes>
                <ColorPaletteResources x:Key="Light" Accent="#0F7B6C" RegionColor="#FFFFFF" />
                <ColorPaletteResources x:Key="Dark" Accent="#3DC2AC" RegionColor="#1F1F1F" />
            </FluentTheme.Palettes>
        </FluentTheme>
        <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />

        <Style Selector="Window.shell">
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI, SF Pro Text, Helvetica Neue, Arial" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource Bg0}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>

        <!-- D5: the accent marks the keyboard focus. The ring is drawn for Tab and arrow navigation, not for a click, and replaces the black and white ring of the theme. -->
        <Style Selector=":is(Control)">
            <Setter Property="FocusAdorner">
                <FocusAdornerTemplate>
                    <Border BorderBrush="{DynamicResource Accent}" BorderThickness="2" CornerRadius="4" />
                </FocusAdornerTemplate>
            </Setter>
        </Style>

        <Style Selector="Border.mark">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="Border.mark TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource AccentFg}" />
        </Style>

        <Style Selector="Menu > MenuItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Padding" Value="8,3" />
        </Style>

        <Style Selector="TabStripItem">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="MinHeight" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,2,0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
        </Style>
        <!-- The active tab takes the editor colour and an accent line, so it reads as the top of the content below -->
        <Style Selector="TabStripItem">
            <Setter Property="Background" Value="{DynamicResource TabBg}" />
            <Setter Property="BorderThickness" Value="0,2,0,0" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="TabStripItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="TabStripItem:selected /template/ Border#PART_SelectedPipe">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="TabStripItem:selected /template/ Border#PART_LayoutRoot, TabStripItem:selected:pointerover /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource BgEditor}" />
        </Style>
        <Style Selector="TabStripItem:pointerover:not(:selected) /template/ Border#PART_LayoutRoot">
            <Setter Property="Background" Value="{DynamicResource TabHoverBg}" />
        </Style>
        <Style Selector="TabStripItem:not(:selected):not(:pointerover) Button.tabclose">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <!-- Avalonia draws the title text and a full-screen button in the window decorations; D5 keeps only the system buttons -->
        <Style Selector="Panel#PART_TitleTextPanel">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Button#PART_FullScreenButton">
            <Setter Property="IsVisible" Value="False" />
        </Style>

        <Style Selector="Button.tabclose">
            <Setter Property="Padding" Value="5" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.tabclose:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
        </Style>
        <Style Selector="Button.tabclose Path">
            <Setter Property="Stroke" Value="{DynamicResource FgMuted}" />
        </Style>

        <Style Selector="Border.content">
            <Setter Property="Background" Value="{DynamicResource BgEditor}" />
        </Style>
        <Style Selector="Border.sidepanel">
            <Setter Property="Background" Value="{DynamicResource Bg1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="0,0,1,0" />
        </Style>
        <Style Selector="Border.statusbar TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
        </Style>

        <Style Selector="Button.statusitem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="6,0" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
        </Style>
        <Style Selector="Button.statusitem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>

        <Style Selector="Border.infobar">
            <Setter Property="Background" Value="{DynamicResource InfoBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="Border.infobar.warning">
            <Setter Property="Background" Value="{DynamicResource WarnBg}" />
        </Style>
        <Style Selector="Border.infobar Button.barbutton">
            <Setter Property="Background" Value="{DynamicResource BgEditor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>

        <Style Selector="Border.palette">
            <Setter Property="Background" Value="{DynamicResource BgEditor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BoxShadow" Value="0 8 28 0 #40000000" />
        </Style>
        <Style Selector="TextBox.paletteinput:focus /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
        <Style Selector="TextBox.paletteinput:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="TextBox.paletteinput">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="CornerRadius" Value="8,8,0,0" />
        </Style>

        <Style Selector="Border.modifieddot">
            <Setter Property="Background" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="Panel.tabslot:not(.modified) Border.modifieddot">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Panel.tabslot.modified Button.tabclose">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="TabStripItem:pointerover Panel.tabslot.modified Button.tabclose">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="TabStripItem:pointerover Panel.tabslot.modified Border.modifieddot">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.sizebadge">
            <Setter Property="Background" Value="{DynamicResource Bg1}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="4,0" />
        </Style>
        <Style Selector="Border.sizebadge TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
        </Style>

        <Style Selector="Border.tabrow">
            <Setter Property="Background" Value="{DynamicResource TabRowBg}" />
        </Style>
        <Style Selector="Grid.titlestrip">
            <Setter Property="Background" Value="{DynamicResource ChromeBg}" />
        </Style>
        <Style Selector="Border.scrim">
            <Setter Property="Background" Value="{DynamicResource Scrim}" />
        </Style>
        <Style Selector="Border.keycap">
            <Setter Property="Background" Value="{DynamicResource Bg1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="5,0" />
            <Setter Property="Margin" Value="2,0,0,0" />
        </Style>
        <Style Selector="Border.keycap TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
        </Style>
        <Style Selector="ListBox.paletteList ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="6,1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="MinHeight" Value="34" />
        </Style>
        <Style Selector="ListBox.paletteList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource SelectedFg}" />
        </Style>
        <Style Selector="ListBox.paletteList ListBoxItem:pointerover:not(:selected) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
        </Style>
        <Style Selector="Border.palettepreview">
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="Background" Value="{DynamicResource Bg1}" />
            <Setter Property="CornerRadius" Value="0,0,8,8" />
        </Style>
        <Style Selector="ListBox.filelist ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="24" />
        </Style>
        <Style Selector="ListBox.doclist ListBoxItem">
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Margin" Value="4,0" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
        <Style Selector="ListBox.doclist ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource SelectedFg}" />
        </Style>
        <Style Selector="ListBox.doclist ListBoxItem:pointerover:not(:selected) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
        </Style>
        <Style Selector="ListBox.filelist ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource SelectedFg}" />
        </Style>
        <Style Selector="ListBox.filelist ListBoxItem:pointerover:not(:selected) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
        </Style>
        <Style Selector="Path.fileglyph">
            <Setter Property="Stroke" Value="{DynamicResource FgMuted}" />
            <Setter Property="StrokeThickness" Value="1.2" />
        </Style>
        <Style Selector="TextBox.panelfilter">
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="FontSize" Value="13" />
        </Style>
        <Style Selector="Border.escchip">
            <Setter Property="Background" Value="{DynamicResource Bg1}" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Border.statusdot">
            <Setter Property="Background" Value="{DynamicResource FgMuted}" />
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="Border.settingrow">
            <Setter Property="Background" Value="{DynamicResource Bg1}" />
        </Style>
        <Style Selector="GridSplitter.groupsplitter">
            <Setter Property="Background" Value="{DynamicResource Border}" />
        </Style>

        <Style Selector="Border.outputpanel">
            <Setter Property="Background" Value="{DynamicResource Bg1}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <Style Selector="ToggleButton.outputtab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="ToggleButton.outputtab:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.outputtab:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="ToggleButton.outputtab:not(:checked):pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="Button.outputaction">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Button.outputaction:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="TextBox.outputtext">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="VerticalContentAlignment" Value="Top" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto" />
        </Style>
        <Style Selector="TextBox.outputtext:focus /template/ Border#PART_BorderElement, TextBox.outputtext:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Border.previewcode">
            <Setter Property="Background" Value="{DynamicResource BgEditor}" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="10,8" />
        </Style>
        <Style Selector="Border.previewquote">
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="3,0,0,0" />
            <Setter Property="Padding" Value="10,0,0,0" />
        </Style>
        <Style Selector="Button.previewlink">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="Border.previewrule">
            <Setter Property="Background" Value="{DynamicResource Border}" />
            <Setter Property="Height" Value="1" />
        </Style>
        <Style Selector="Border.previewcell">
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="8,4" />
        </Style>
        <Style Selector="Border.previewcellhead">
            <Setter Property="Background" Value="{DynamicResource BgEditor}" />
        </Style>
        <Style Selector="Button.previewoutline">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="4,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style Selector="SelectableTextBlock.previewhead1"><Setter Property="FontSize" Value="22" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style Selector="SelectableTextBlock.previewhead2"><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style Selector="SelectableTextBlock.previewhead3"><Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style Selector="SelectableTextBlock.previewhead4, SelectableTextBlock.previewhead5, SelectableTextBlock.previewhead6"><Setter Property="FontWeight" Value="SemiBold" /></Style>

        <Style Selector="Border.findbar">
            <Setter Property="Background" Value="{DynamicResource BgEditor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
        </Style>
        <Style Selector="TextBox.findinput">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Background" Value="{DynamicResource BgEditor}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Border}" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="TextBlock.findcount">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
        </Style>
        <Style Selector="TextBlock.findcount.error">
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
        </Style>
        <Style Selector="ToggleButton.findtoggle">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
        </Style>
        <Style Selector="ToggleButton.findtoggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
        </Style>
        <Style Selector="ToggleButton.findtoggle:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource SelectedFg}" />
        </Style>
        <Style Selector="Button.findbutton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Foreground" Value="{DynamicResource Fg}" />
        </Style>
        <Style Selector="Button.findbutton:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
        </Style>

        <Style Selector="TextBlock.resultfile">
            <Setter Property="Foreground" Value="{DynamicResource Accent}" />
        </Style>
        <Style Selector="TextBlock.resultmuted">
            <Setter Property="Foreground" Value="{DynamicResource FgMuted}" />
        </Style>
        <Style Selector="TextBlock.resultbad">
            <Setter Property="Foreground" Value="{DynamicResource Danger}" />
        </Style>
        <Style Selector="TextBlock.resultgood">
            <Setter Property="Foreground" Value="{DynamicResource Good}" />
        </Style>
        <Style Selector="ListBox.resultlist ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="5" />
        </Style>
        <Style Selector="ListBox.resultlist ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
            <Setter Property="Foreground" Value="{DynamicResource SelectedFg}" />
        </Style>
        <Style Selector="ListBox.resultlist ListBoxItem:pointerover:not(:selected) /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BgHover}" />
        </Style>
        <Style Selector="DockPanel.results">
            <Setter Property="Background" Value="{DynamicResource BgEditor}" />
        </Style>
    </Application.Styles>
</Application>
