<Project>
  <!--
    A plugin is published with NativeAOT, so
    - trimming and AOT analyzer findings fail the build instead of staying warnings,
    - System.Text.Json refuses its reflection-based serializer at run time.
    The analyzer NKSPLG001 (no reflection) comes with the package, or with Plugin.props inside the repository of the editor.
  -->
  <PropertyGroup>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2050;IL2057;IL2062;IL2067;IL2070;IL2072;IL2075;IL2077;IL2080;IL2087;IL2091;IL3050;IL3051;IL3002;IL3003</WarningsAsErrors>
  </PropertyGroup>
</Project>
