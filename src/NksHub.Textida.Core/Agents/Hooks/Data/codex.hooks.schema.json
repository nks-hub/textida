{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Codex hooks",
  "description": "The hooks of a Codex hooks.json, as the public documentation (https://developers.openai.com/codex/hooks) describes them.",
  "type": "object",
  "properties": {
    "description": {
      "type": "string"
    },
    "hooks": {
      "$ref": "#/definitions/hooks"
    }
  },
  "definitions": {
    "hooks": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "SessionStart",
          "SessionEnd",
          "SubagentStart",
          "PreToolUse",
          "PermissionRequest",
          "PostToolUse",
          "PreCompact",
          "PostCompact",
          "UserPromptSubmit",
          "SubagentStop",
          "Stop",
          "Interrupt"
        ]
      },
      "additionalProperties": {
        "type": "array",
        "items": {
          "$ref": "#/definitions/group"
        }
      }
    },
    "group": {
      "type": "object",
      "required": [
        "hooks"
      ],
      "properties": {
        "matcher": {
          "type": "string"
        },
        "hooks": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/handler"
          }
        }
      },
      "additionalProperties": false
    },
    "handler": {
      "type": "object",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "command",
            "mcp_tool",
            "prompt",
            "agent"
          ]
        },
        "timeout": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "statusMessage": {
          "type": "string"
        },
        "command": {
          "type": "string",
          "minLength": 1
        },
        "commandWindows": {
          "type": "string"
        },
        "async": {
          "type": "boolean"
        },
        "additionalContextLimit": {
          "type": "integer",
          "minimum": 0
        },
        "server": {
          "type": "string",
          "minLength": 1
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "input": {
          "type": "object"
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "command"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "command"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "mcp_tool"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "server",
              "tool"
            ]
          }
        }
      ]
    }
  }
}
