<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <InternalsVisibleTo Include="NksHub.Textida.Core.Tests" />
    <InternalsVisibleTo Include="NksHub.Textida.Document.Contract" />
    <InternalsVisibleTo Include="NksHub.Textida.App.Tests" />
    <InternalsVisibleTo Include="NksHub.Textida.Remote.Tests" />
    <InternalsVisibleTo Include="NksHub.Textida.Journal.CrashHarness" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Syntax\Grammars\*.json" LogicalName="Grammars/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Syntax\Dialects\*.json" LogicalName="Dialects/%(Filename)%(Extension)" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Trimming and AOT analyzer findings fail the build instead of staying warnings. -->
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2050;IL2057;IL2062;IL2067;IL2070;IL2072;IL2075;IL2077;IL2080;IL2087;IL2091;IL3050;IL3051;IL3002;IL3003</WarningsAsErrors>
  </PropertyGroup>

</Project>
