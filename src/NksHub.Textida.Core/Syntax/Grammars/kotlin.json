{
  "$schema": "grammar.schema.json",
  "formatVersion": 1,
  "id": "kotlin",
  "name": "Kotlin",
  "comments": {"line": "//", "block": ["/*", "*/"]},
  "version": "1.0.0",
  "extensions": [".kt", ".kts"],
  "keywords": [
    {
      "name": "keywords",
      "token": "keyword",
      "words": [
        "as", "break", "class", "continue", "do", "else", "for", "fun", "if", "in", "interface", "is",
        "object", "package", "return", "super", "this", "throw", "try", "typealias", "val", "var", "when",
        "while", "by", "catch", "constructor", "delegate", "dynamic", "field", "file", "finally", "get",
        "import", "init", "param", "property", "receiver", "set", "setparam", "value", "where", "abstract",
        "actual", "annotation", "companion", "const", "crossinline", "data", "enum", "expect", "external",
        "final", "infix", "inline", "inner", "internal", "lateinit", "noinline", "open", "operator", "out",
        "override", "private", "protected", "public", "reified", "sealed", "suspend", "tailrec", "vararg"
      ]
    },
    {
      "name": "types",
      "token": "type",
      "words": [
        "Int", "Long", "Short", "Byte", "Float", "Double", "Boolean", "Char", "String", "Unit", "Any",
        "Nothing", "Array", "List", "Map", "Set", "MutableList", "MutableMap", "MutableSet", "Pair",
        "Sequence"
      ]
    },
    {"name": "constants", "token": "constant", "words": ["true", "false", "null"]}
  ],
  "repository": {
    "code": [
      {"name": "doc-comment", "begin": "/\\*\\*(?!/)", "end": "\\*/", "token": "comment.doc", "multiline": true},
      {"name": "block-comment", "begin": "/\\*", "end": "\\*/", "token": "comment", "multiline": true},
      {"name": "comment-line", "begin": "//", "end": "$", "token": "comment"},
      {
        "name": "raw-string",
        "begin": "\"\"\"",
        "end": "\"\"\"",
        "token": "string",
        "multiline": true,
        "rules": [
          {"match": "\\$[A-Za-z_]\\w*", "token": "variable"},
          {
            "name": "template-expr",
            "begin": "\\$\\{",
            "end": "\\}",
            "multiline": true,
            "beginToken": "punctuation",
            "endToken": "punctuation",
            "rules": [
              {"include": "#code"}
            ]
          }
        ]
      },
      {
        "name": "dq-string",
        "begin": "\"",
        "end": "\"",
        "token": "string",
        "rules": [
          {"match": "\\\\.", "token": "string.escape"},
          {"match": "\\$[A-Za-z_]\\w*", "token": "variable"},
          {
            "name": "template-expr",
            "begin": "\\$\\{",
            "end": "\\}",
            "multiline": true,
            "beginToken": "punctuation",
            "endToken": "punctuation",
            "rules": [
              {"include": "#code"}
            ]
          }
        ]
      },
      {"match": "'(?:[^'\\\\\\r\\n]|\\\\(?:u[0-9a-fA-F]{4}|.))'", "token": "string"},
      {"match": "@[A-Za-z_]\\w*(?::[A-Za-z_]\\w*)?|(?<=\\w)@[A-Za-z_]\\w*", "token": "meta"},
      {
        "match": "(?<![\\w.])(?:0[xX][0-9a-fA-F_]+|0[bB][01_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?)[uUlLfF]*",
        "token": "number"
      },
      {
        "match": "(?<=\\bfun[ \\t]+(?:<[^>\\r\\n]*>[ \\t]*)?(?:[A-Za-z_][\\w.]*(?:<[^>\\r\\n]*>)?\\.)?)[A-Za-z_]\\w*(?![\\w.<])",
        "token": "function"
      },
      {"match": "(?<=\\b(?:class|interface|object|typealias)[ \\t]+)[A-Za-z_]\\w*", "token": "type"},
      {"words": true},
      {
        "operators": [
          "===", "!==", "?:", "?.", "!!", "::", "..<", "..", "->", "=>", "++", "--", "&&", "||", "==", "!=",
          "<=", ">=", "+=", "-=", "*=", "/=", "%=", "+", "-", "*", "/", "%", "=", "<", ">", "!", "?", ":"
        ]
      },
      {"match": "[{}()\\[\\];,.]", "token": "punctuation"}
    ]
  },
  "rules": [
    {"include": "#code"}
  ]
}
