{
  "$schema": "grammar.schema.json",
  "formatVersion": 1,
  "id": "dart",
  "name": "Dart",
  "comments": {"line": "//", "block": ["/*", "*/"]},
  "version": "1.0.0",
  "extensions": [".dart"],
  "wordPattern": "[A-Za-z_$][\\w$]*",
  "keywords": [
    {
      "name": "keywords",
      "token": "keyword",
      "words": [
        "abstract", "as", "assert", "async", "await", "base", "break", "case", "catch", "class", "const",
        "continue", "covariant", "default", "deferred", "do", "dynamic", "else", "enum", "export", "extends",
        "extension", "external", "factory", "final", "finally", "for", "Function", "get", "hide", "if",
        "implements", "import", "in", "interface", "is", "late", "library", "mixin", "new", "on", "operator",
        "part", "required", "rethrow", "return", "sealed", "set", "show", "static", "super", "switch",
        "sync", "this", "throw", "try", "typedef", "var", "when", "while", "with", "yield"
      ]
    },
    {
      "name": "types",
      "token": "type",
      "words": [
        "int", "double", "num", "bool", "String", "List", "Map", "Set", "Object", "Iterable", "Future",
        "Stream", "Duration", "DateTime", "Null", "void", "Never", "Type", "Function", "Record", "Symbol"
      ]
    },
    {"name": "constants", "token": "constant", "words": ["true", "false", "null"]}
  ],
  "repository": {
    "code": [
      {"name": "doc-block-comment", "begin": "/\\*\\*(?!/)", "end": "\\*/", "token": "comment.doc", "multiline": true},
      {"name": "block-comment", "begin": "/\\*", "end": "\\*/", "token": "comment", "multiline": true},
      {"name": "doc-line-comment", "begin": "///", "end": "$", "token": "comment.doc"},
      {"name": "comment-line", "begin": "//", "end": "$", "token": "comment"},
      {"match": "(?<=^)#!.*$", "token": "meta"},
      {"name": "raw-multi-dq", "begin": "r\"\"\"", "end": "\"\"\"", "token": "string", "multiline": true},
      {"name": "raw-multi-sq", "begin": "r'''", "end": "'''", "token": "string", "multiline": true},
      {"name": "raw-dq", "begin": "r\"", "end": "\"", "token": "string"},
      {"name": "raw-sq", "begin": "r'", "end": "'", "token": "string"},
      {
        "name": "multi-dq",
        "begin": "\"\"\"",
        "end": "\"\"\"",
        "token": "string",
        "multiline": true,
        "rules": [
          {"match": "\\\\.", "token": "string.escape"},
          {"match": "\\$[A-Za-z_]\\w*", "token": "variable"},
          {
            "name": "template-expr",
            "begin": "\\$\\{",
            "end": "\\}",
            "multiline": true,
            "beginToken": "punctuation",
            "endToken": "punctuation",
            "rules": [
              {"include": "#code"}
            ]
          }
        ]
      },
      {
        "name": "multi-sq",
        "begin": "'''",
        "end": "'''",
        "token": "string",
        "multiline": true,
        "rules": [
          {"match": "\\\\.", "token": "string.escape"},
          {"match": "\\$[A-Za-z_]\\w*", "token": "variable"},
          {
            "name": "template-expr",
            "begin": "\\$\\{",
            "end": "\\}",
            "multiline": true,
            "beginToken": "punctuation",
            "endToken": "punctuation",
            "rules": [
              {"include": "#code"}
            ]
          }
        ]
      },
      {
        "name": "dq-string",
        "begin": "\"",
        "end": "\"",
        "token": "string",
        "rules": [
          {"match": "\\\\.", "token": "string.escape"},
          {"match": "\\$[A-Za-z_]\\w*", "token": "variable"},
          {
            "name": "template-expr",
            "begin": "\\$\\{",
            "end": "\\}",
            "multiline": true,
            "beginToken": "punctuation",
            "endToken": "punctuation",
            "rules": [
              {"include": "#code"}
            ]
          }
        ]
      },
      {
        "name": "sq-string",
        "begin": "'",
        "end": "'",
        "token": "string",
        "rules": [
          {"match": "\\\\.", "token": "string.escape"},
          {"match": "\\$[A-Za-z_]\\w*", "token": "variable"},
          {
            "name": "template-expr",
            "begin": "\\$\\{",
            "end": "\\}",
            "multiline": true,
            "beginToken": "punctuation",
            "endToken": "punctuation",
            "rules": [
              {"include": "#code"}
            ]
          }
        ]
      },
      {"match": "@[A-Za-z_][\\w.]*", "token": "meta"},
      {
        "match": "(?<![\\w.])(?:0[xX][0-9a-fA-F_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?|\\.\\d[\\d_]*)",
        "token": "number"
      },
      {"match": "(?<=\\b(?:class|mixin|enum|extension|typedef)[ \\t]+)[A-Za-z_]\\w*", "token": "type"},
      {"words": true},
      {
        "operators": [
          "...?", "...", "??=", "??", "?.", "..", "=>", "~/=", "~/", ">>>=", ">>>", "<<=", ">>=", "++", "--",
          "&&", "||", "==", "!=", "<=", ">=", "+=", "-=", "*=", "/=", "%=", "&=", "|=", "^=", "<<", ">>", "+",
          "-", "*", "/", "%", "=", "<", ">", "!", "~", "&", "|", "^", "?", ":"
        ]
      },
      {"match": "[{}()\\[\\];,.]", "token": "punctuation"}
    ]
  },
  "rules": [
    {"include": "#code"}
  ]
}
