{
  "$schema": "grammar.schema.json",
  "formatVersion": 1,
  "id": "vb",
  "name": "Visual Basic",
  "comments": {"line": "'"},
  "version": "1.0.0",
  "caseSensitive": false,
  "extensions": [".vb", ".vbs", ".bas"],
  "wordPattern": "[A-Za-z_]\\w*",
  "keywords": [
    {
      "name": "constants",
      "token": "constant",
      "words": ["true", "false", "nothing"]
    },
    {
      "name": "types",
      "token": "type",
      "words": [
        "boolean", "byte", "char", "date", "decimal", "double", "integer", "long", "object", "sbyte", "short", "single",
        "string", "uinteger", "ulong", "ushort", "variant"
      ]
    },
    {
      "name": "operators",
      "token": "operator",
      "words": ["and", "andalso", "or", "orelse", "not", "xor", "mod", "is", "isnot", "like"]
    },
    {
      "name": "keywords",
      "token": "keyword",
      "words": [
        "addhandler", "addressof", "as", "byref", "byval", "call", "case", "catch", "class", "const", "continue", "ctype",
        "declare", "default", "delegate", "dim", "directcast", "do", "each", "else", "elseif", "end", "enum", "erase",
        "error", "event", "exit", "finally", "for", "friend", "function", "get", "gettype", "global", "gosub", "goto",
        "handles", "if", "implements", "imports", "in", "inherits", "interface", "let", "lib", "loop", "me", "module",
        "mustinherit", "mustoverride", "mybase", "myclass", "namespace", "narrowing", "new", "next", "notinheritable",
        "notoverridable", "of", "on", "operator", "option", "optional", "overloads", "overridable", "overrides",
        "paramarray", "partial", "preserve", "private", "property", "protected", "public", "raiseevent", "readonly",
        "redim", "removehandler", "resume", "return", "select", "set", "shadows", "shared", "static", "step", "stop",
        "structure", "sub", "synclock", "then", "throw", "to", "try", "trycast", "typeof", "using", "wend", "when",
        "while", "widening", "with", "withevents", "writeonly", "yield", "async", "await", "iterator"
      ]
    }
  ],
  "repository": {
    "xml-entity": [
      {"match": "&(?:#\\d+|#[xX][0-9A-Fa-f]+|[A-Za-z]+);", "token": "string.escape"}
    ],
    "xml-embedded": [
      {
        "name": "xml-embedded-expression",
        "begin": "<%=",
        "end": "%>",
        "multiline": true,
        "beginToken": "meta",
        "endToken": "meta",
        "embed": "vb"
      }
    ],
    "xml-comment": [
      {"name": "xml-comment", "begin": "<!--", "end": "-->", "token": "comment", "multiline": true}
    ],
    "xml-cdata": [
      {"name": "xml-cdata", "begin": "<!\\[CDATA\\[", "end": "\\]\\]>", "token": "string", "multiline": true}
    ],
    "xml-instruction": [
      {"name": "xml-instruction", "begin": "<\\?", "end": "\\?>", "token": "meta", "multiline": true}
    ],
    "xml-attribute-value": [
      {
        "name": "xml-dq",
        "begin": "\"",
        "end": "\"",
        "token": "string",
        "multiline": true,
        "rules": [{"include": "#xml-embedded"}, {"include": "#xml-entity"}]
      },
      {
        "name": "xml-sq",
        "begin": "'",
        "end": "'",
        "token": "string",
        "multiline": true,
        "rules": [{"include": "#xml-embedded"}, {"include": "#xml-entity"}]
      }
    ],
    "xml-tag-body": [
      {"include": "#xml-attribute-value"},
      {"include": "#xml-embedded"},
      {"match": "[A-Za-z_][\\w:.-]*", "token": "attribute"},
      {"match": "=", "token": "operator"},
      {
        "name": "xml-content",
        "begin": ">",
        "end": "(?=</)",
        "multiline": true,
        "beginToken": "tag",
        "rules": [
          {"include": "#xml-comment"},
          {"include": "#xml-cdata"},
          {"include": "#xml-instruction"},
          {"include": "#xml-embedded"},
          {"include": "#xml-entity"},
          {"include": "#xml-element"}
        ]
      }
    ],
    "xml-element": [
      {
        "name": "xml-element",
        "begin": "<[A-Za-z_][\\w:.-]*",
        "end": "/>|</[\\w:.-]*[ \\t]*>",
        "multiline": true,
        "beginToken": "tag",
        "endToken": "tag",
        "rules": [{"include": "#xml-tag-body"}]
      }
    ]
  },
  "rules": [
    {"name": "doc-comment", "begin": "'''", "end": "$", "token": "comment.doc"},
    {"name": "comment-line", "begin": "'", "end": "$", "token": "comment"},
    {"name": "rem-comment", "begin": "(?<=^[ \\t]*)rem(?![\\w])", "end": "$", "token": "comment"},
    {"name": "preprocessor-line", "begin": "(?<=^[ \\t]*)#(?=[A-Za-z])", "end": "$", "token": "preprocessor"},
    {
      "name": "xml-document",
      "begin": "(?<=(?:=|\\b(?:return|yield|await|in)\\b)[ \\t]*)<\\?xml",
      "end": "(?<=/>|</[\\w:.-]*[ \\t]*>)",
      "multiline": true,
      "beginToken": "meta",
      "rules": [
        {"match": "\\?>", "token": "meta"},
        {"include": "#xml-attribute-value"},
        {"match": "[A-Za-z_][\\w:.-]*", "token": "attribute"},
        {"match": "=", "token": "operator"},
        {"include": "#xml-comment"},
        {"include": "#xml-element"}
      ]
    },
    {"name": "xml-literal-comment", "begin": "(?<=(?:=|\\b(?:return|yield|await|in)\\b)[ \\t]*)<!--", "end": "-->", "token": "comment", "multiline": true},
    {"name": "xml-literal-cdata", "begin": "(?<=(?:=|\\b(?:return|yield|await|in)\\b)[ \\t]*)<!\\[CDATA\\[", "end": "\\]\\]>", "token": "string", "multiline": true},
    {
      "name": "xml-literal",
      "begin": "(?<=(?:=|\\b(?:return|yield|await|in)\\b)[ \\t]*)<[A-Za-z_][\\w:.-]*",
      "end": "/>|</[\\w:.-]*[ \\t]*>",
      "multiline": true,
      "beginToken": "tag",
      "endToken": "tag",
      "rules": [{"include": "#xml-tag-body"}]
    },
    {
      "name": "xml-namespace-import",
      "begin": "(?<=\\bimports[ \\t]+)<(?=xmlns)",
      "end": ">",
      "beginToken": "tag",
      "endToken": "tag",
      "rules": [
        {"include": "#xml-attribute-value"},
        {"match": "[A-Za-z_][\\w:.-]*", "token": "attribute"},
        {"match": "=", "token": "operator"}
      ]
    },
    {
      "name": "string",
      "begin": "\"",
      "end": "\"",
      "token": "string",
      "rules": [
        {"match": "\"\"", "token": "string.escape"}
      ]
    },
    {"match": "(?<=\\b(?:sub|function)[ \\t]+)[A-Za-z_]\\w*", "token": "function"},
    {"match": "(?<=\\b(?:class|module|structure|interface|enum)[ \\t]+)[A-Za-z_]\\w*", "token": "type"},
    {
      "match": "(?<![\\w.])(?:&[Hh][0-9A-Fa-f]+|&[Oo][0-7]+|\\d+(?:\\.\\d+)?(?:[eE][+-]?\\d+)?)(?:UL|LU|[LSIUDFR])?(?![\\w])",
      "token": "number"
    },
    {"words": true},
    {"operators": ["<>", "<=", ">=", ":=", "+=", "-=", "*=", "/=", "\\=", "^=", "&=", "=", "<", ">", "+", "-", "*", "/", "\\", "^", "&"]},
    {"match": "[(){},.:]", "token": "punctuation"}
  ]
}
