{
  "$schema": "grammar.schema.json",
  "formatVersion": 1,
  "id": "rust",
  "name": "Rust",
  "comments": {"line": "//", "block": ["/*", "*/"]},
  "version": "1.0.0",
  "extensions": [".rs"],
  "keywords": [
    {
      "name": "keywords",
      "token": "keyword",
      "words": [
        "as", "async", "await", "break", "const", "continue", "crate", "dyn", "else", "enum", "extern", "fn",
        "for", "if", "impl", "in", "let", "loop", "macro_rules", "match", "mod", "move", "mut", "pub", "ref",
        "return", "self", "static", "struct", "super", "trait", "type", "union", "unsafe", "use", "where",
        "while", "yield"
      ]
    },
    {
      "name": "types",
      "token": "type",
      "words": [
        "bool", "char", "str", "i8", "i16", "i32", "i64", "i128", "isize", "u8", "u16", "u32", "u64", "u128",
        "usize", "f32", "f64", "Self", "String", "Vec", "Option", "Result", "Box", "Rc", "Arc", "HashMap",
        "HashSet", "BTreeMap"
      ]
    },
    {"name": "constants", "token": "constant", "words": ["true", "false", "None", "Some", "Ok", "Err"]}
  ],
  "rules": [
    {"name": "doc-block-comment", "begin": "/\\*[*!](?![*/])", "end": "\\*/", "token": "comment.doc", "multiline": true},
    {"name": "block-comment", "begin": "/\\*", "end": "\\*/", "token": "comment", "multiline": true},
    {"name": "doc-line-comment", "begin": "//[/!](?!/)", "end": "$", "token": "comment.doc"},
    {"name": "comment-line", "begin": "//", "end": "$", "token": "comment"},
    {"name": "raw-string-2", "begin": "b?r##\"", "end": "\"##", "token": "string", "multiline": true},
    {"name": "raw-string-1", "begin": "b?r#\"", "end": "\"#", "token": "string", "multiline": true},
    {"name": "raw-string-0", "begin": "b?r\"", "end": "\"", "token": "string", "multiline": true},
    {
      "name": "dq-string",
      "begin": "b?\"",
      "end": "\"",
      "token": "string",
      "multiline": true,
      "rules": [
        {"match": "\\\\.", "token": "string.escape"}
      ]
    },
    {"match": "b?'(?:[^'\\\\\\r\\n]|\\\\(?:x[0-9a-fA-F]{2}|u\\{[0-9a-fA-F_]+\\}|.))'", "token": "string"},
    {"match": "'[A-Za-z_]\\w*", "token": "variable"},
    {"match": "#!?\\[[^\\]\\r\\n]*\\]?", "token": "meta"},
    {
      "match": "(?<![\\w.])(?:0x[0-9a-fA-F_]+|0o[0-7_]+|0b[01_]+|\\d[\\d_]*(?:\\.\\d[\\d_]*)?(?:[eE][+-]?\\d+)?)(?:[iuf](?:8|16|32|64|128|size))?",
      "token": "number"
    },
    {"match": "(?<=\\bfn[ \\t]+)[A-Za-z_]\\w*", "token": "function"},
    {"match": "(?<=\\b(?:struct|enum|trait|type|union|mod)[ \\t]+)[A-Za-z_]\\w*", "token": "type"},
    {"match": "(?<![\\w$])[A-Za-z_]\\w*!(?!=)", "token": "function"},
    {"words": true},
    {
      "operators": [
        "<<=", ">>=", "...", "..=", "::", "->", "=>", "..", "&&", "||", "==", "!=", "<=", ">=", "+=", "-=",
        "*=", "/=", "%=", "&=", "|=", "^=", "<<", ">>", "+", "-", "*", "/", "%", "=", "<", ">", "!", "&",
        "|", "^", "?"
      ]
    },
    {"match": "[{}()\\[\\];,.]", "token": "punctuation"}
  ]
}
