{
  "$schema": "grammar.schema.json",
  "formatVersion": 1,
  "id": "cpp",
  "name": "C++",
  "comments": {"line": "//", "block": ["/*", "*/"]},
  "version": "1.0.0",
  "extensions": [
    ".cpp", ".cc", ".cxx", ".c++", ".hpp", ".hh", ".hxx", ".h", ".ipp", ".inl", ".tpp", ".cppm", ".ixx"
  ],
  "keywords": [
    {
      "name": "keywords",
      "token": "keyword",
      "words": [
        "auto", "break", "case", "const", "continue", "default", "do", "else", "enum", "extern", "for",
        "goto", "if", "inline", "register", "restrict", "return", "sizeof", "static", "struct", "switch",
        "typedef", "union", "volatile", "while", "_Alignas", "_Alignof", "_Atomic", "_Generic", "_Noreturn",
        "_Static_assert", "_Thread_local", "alignas", "alignof", "static_assert", "thread_local",
        "constexpr", "typeof", "class", "namespace", "template", "typename", "using", "new", "delete",
        "this", "public", "private", "protected", "virtual", "override", "final", "explicit", "friend",
        "operator", "try", "catch", "throw", "noexcept", "consteval", "constinit", "mutable", "decltype",
        "static_cast", "dynamic_cast", "reinterpret_cast", "const_cast", "concept", "requires", "co_await",
        "co_return", "co_yield", "export", "import", "module", "and", "or", "not", "xor", "and_eq", "or_eq",
        "not_eq", "bitand", "bitor", "compl"
      ]
    },
    {
      "name": "types",
      "token": "type",
      "words": [
        "bool", "char", "double", "float", "int", "long", "short", "signed", "unsigned", "void", "_Bool",
        "_Complex", "size_t", "ssize_t", "ptrdiff_t", "intptr_t", "uintptr_t", "int8_t", "int16_t",
        "int32_t", "int64_t", "uint8_t", "uint16_t", "uint32_t", "uint64_t", "wchar_t", "FILE", "va_list",
        "char8_t", "char16_t", "char32_t", "string", "wstring", "string_view", "vector", "map", "set",
        "unordered_map", "unique_ptr", "shared_ptr", "optional"
      ]
    },
    {"name": "constants", "token": "constant", "words": ["true", "false", "NULL", "nullptr"]}
  ],
  "rules": [
    {"name": "doc-comment", "begin": "/\\*\\*(?!/)", "end": "\\*/", "token": "comment.doc", "multiline": true},
    {"name": "block-comment", "begin": "/\\*", "end": "\\*/", "token": "comment", "multiline": true},
    {"name": "comment-doc-line", "begin": "///", "end": "$", "token": "comment.doc"},
    {"name": "comment-line", "begin": "//", "end": "$", "token": "comment"},
    {
      "name": "preprocessor-line",
      "begin": "(?<=^[ \\t]*)#[ \\t]*[A-Za-z]+",
      "end": "(?<!\\\\)$",
      "token": "preprocessor",
      "multiline": true,
      "rules": [
        {"name": "block-comment", "begin": "/\\*", "end": "\\*/", "token": "comment", "multiline": true},
        {"name": "comment-line", "begin": "//", "end": "$", "token": "comment"},
        {
          "name": "dq-string",
          "begin": "\"",
          "end": "\"",
          "token": "string",
          "rules": [
            {"match": "\\\\.", "token": "string.escape"}
          ]
        },
        {"match": "<[^>\\r\\n]+>", "token": "string"}
      ]
    },
    {
      "name": "raw-string",
      "begin": "(?<![\\w])(?:u8|[uUL])?R\"\\(",
      "end": "\\)\"",
      "token": "string",
      "multiline": true
    },
    {
      "name": "dq-string",
      "begin": "(?<![\\w])(?:u8|[uUL])?\"",
      "end": "\"",
      "token": "string",
      "rules": [
        {"match": "\\\\.", "token": "string.escape"}
      ]
    },
    {
      "match": "(?<![\\w])(?:u8|[uUL])?'(?:[^'\\\\\\r\\n]|\\\\(?:x[0-9a-fA-F]+|[0-7]{1,3}|u[0-9a-fA-F]{4}|.))'",
      "token": "string"
    },
    {
      "match": "(?<=\\b(?:struct|union|enum|class|namespace)[ \\t]+(?:class[ \\t]+|struct[ \\t]+)?)[A-Za-z_]\\w*",
      "token": "type"
    },
    {
      "match": "(?<![\\w.])(?:0[xX][0-9a-fA-F_']+|0[bB][01_']+|\\d[\\d_']*(?:\\.\\d*)?(?:[eE][+-]?\\d+)?|\\.\\d+(?:[eE][+-]?\\d+)?)[uUlLfFdDzZ]*",
      "token": "number"
    },
    {"words": true},
    {
      "operators": [
        "<<=", ">>=", "<=>", "->*", "...", "::", "->", "++", "--", "&&", "||", "==", "!=", "<=", ">=", "+=",
        "-=", "*=", "/=", "%=", "&=", "|=", "^=", "<<", ">>", "+", "-", "*", "/", "%", "=", "<", ">", "!",
        "~", "&", "|", "^", "?", ":"
      ]
    },
    {"match": "[{}()\\[\\];,.]", "token": "punctuation"}
  ]
}
