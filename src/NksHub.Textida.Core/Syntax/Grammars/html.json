{
  "$schema": "grammar.schema.json",
  "formatVersion": 1,
  "id": "html",
  "name": "HTML",
  "comments": {"block": ["<!--", "-->"]},
  "version": "1.0.0",
  "caseSensitive": false,
  "extensions": [".html", ".htm", ".xhtml", ".shtml", ".vue", ".svelte", ".ejs", ".twig", ".tpl"],
  "firstLine": "^\\s*<!doctype\\s+html",
  "repository": {
    "php": [
      {"name": "php", "begin": "<\\?(?:php\\b|=)", "end": "\\?>", "multiline": true, "beginToken": "meta", "endToken": "meta", "embed": "php-code"},
      {"name": "processing", "begin": "<\\?", "end": "\\?>", "token": "meta", "multiline": true}
    ],
    "attrs": [
      {"include": "#php"},
      {
        "name": "dq-attr",
        "begin": "\"",
        "end": "\"",
        "token": "string",
        "multiline": true,
        "rules": [
          {"include": "#php"},
          {"match": "&(?:#\\d+|#[xX][0-9a-fA-F]+|[A-Za-z][A-Za-z0-9]*);", "token": "string.escape"}
        ]
      },
      {
        "name": "sq-attr",
        "begin": "'",
        "end": "'",
        "token": "string",
        "multiline": true,
        "rules": [
          {"include": "#php"},
          {"match": "&(?:#\\d+|#[xX][0-9a-fA-F]+|[A-Za-z][A-Za-z0-9]*);", "token": "string.escape"}
        ]
      },
      {"match": "=", "token": "operator"},
      {"match": "[^\\s\\\"'=<>/`]+(?=\\s*=)|[A-Za-z_:@][\\w:.@-]*", "token": "attribute"}
    ]
  },
  "rules": [
    {"name": "comment", "begin": "<!--", "end": "-->", "token": "comment", "multiline": true},
    {"include": "#php"},
    {"match": "<!doctype[^>]*>", "token": "meta"},
    {"name": "cdata", "begin": "<!\\[CDATA\\[", "end": "\\]\\]>", "token": "string", "multiline": true},
    {
      "name": "style",
      "begin": "<style(?=[\\s>/])[^>]*>",
      "end": "</style\\s*>",
      "multiline": true,
      "beginToken": "tag",
      "endToken": "tag",
      "embed": "css",
      "rules": [
        {"include": "#php"}
      ]
    },
    {
      "name": "script",
      "begin": "<script(?=[\\s>/])[^>]*>",
      "end": "</script\\s*>",
      "multiline": true,
      "beginToken": "tag",
      "endToken": "tag",
      "embed": "javascript",
      "rules": [
        {"include": "#php"}
      ]
    },
    {"match": "</[a-z][\\w:.-]*\\s*>", "token": "tag"},
    {
      "name": "tag",
      "begin": "<[a-z][\\w:.-]*",
      "end": "/?>",
      "multiline": true,
      "beginToken": "tag",
      "endToken": "tag",
      "rules": [
        {"include": "#attrs"}
      ]
    },
    {"match": "&(?:#\\d+|#[xX][0-9a-fA-F]+|[A-Za-z][A-Za-z0-9]*);", "token": "string.escape"}
  ]
}
