{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": ".mcp.json",
  "description": "Project MCP servers of Claude Code (https://code.claude.com/docs/en/mcp). An entry with a url needs a type, because an entry without one is read as a stdio server.",
  "type": "object",
  "required": [
    "mcpServers"
  ],
  "properties": {
    "mcpServers": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/server"
      }
    }
  },
  "definitions": {
    "server": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "stdio",
            "http",
            "sse",
            "ws"
          ]
        },
        "command": {
          "type": "string"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "env": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "url": {
          "type": "string"
        },
        "headers": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "url"
            ]
          },
          "then": {
            "required": [
              "type"
            ]
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "http",
                  "sse",
                  "ws"
                ]
              }
            }
          },
          "then": {
            "required": [
              "url"
            ]
          }
        },
        {
          "if": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "url"
                  ]
                },
                {
                  "required": [
                    "type"
                  ]
                }
              ]
            }
          },
          "then": {
            "required": [
              "command"
            ]
          }
        },
        {
          "if": {
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "stdio"
              }
            }
          },
          "then": {
            "required": [
              "command"
            ]
          }
        }
      ]
    }
  }
}
