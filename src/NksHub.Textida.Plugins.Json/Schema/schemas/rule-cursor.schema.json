{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Cursor rule",
  "description": "Frontmatter of .mdc rule files (https://cursor.com/docs/context/rules).",
  "type": "object",
  "properties": {
    "description": {
      "type": "string"
    },
    "globs": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      ]
    },
    "alwaysApply": {
      "type": "boolean"
    }
  }
}
