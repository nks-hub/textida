{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "opencode.json",
  "description": "Keys of https://opencode.ai/config.json whose type is stated there. The file is read as JSONC.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "model": {
      "type": [
        "string",
        "object"
      ]
    },
    "autoupdate": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "enum": [
            "notify"
          ]
        }
      ]
    }
  }
}
