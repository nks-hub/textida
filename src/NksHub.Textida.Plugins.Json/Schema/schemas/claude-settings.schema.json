{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Claude Code settings",
  "description": "Keys of https://code.claude.com/docs/en/settings-reference that are checked here. The file is strict JSON.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "cleanupPeriodDays": {
      "type": "integer",
      "minimum": 1
    },
    "permissions": {
      "type": "object",
      "properties": {
        "allow": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ask": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "deny": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
