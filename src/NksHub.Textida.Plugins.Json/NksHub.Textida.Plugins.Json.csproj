<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <Import Project="..\NksHub.Textida.PluginSdk\Plugin.props" />

  <ItemGroup>
    <EmbeddedResource Include="Schema\schemas\*.schema.json" LogicalName="schemas/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\NksHub.Textida.Workbench\schemas\settings.schema.json" LogicalName="schemas/textida-settings.schema.json" />
    <EmbeddedResource Include="..\NksHub.Textida.Workbench\schemas\keymap.schema.json" LogicalName="schemas/textida-keymap.schema.json" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NksHub.Textida.PluginSdk\NksHub.Textida.PluginSdk.csproj" />
  </ItemGroup>

</Project>
