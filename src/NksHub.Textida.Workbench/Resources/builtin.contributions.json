    {
      "key": "mod+f",
      "command": "nks.search.find"
    },
    {
      "key": "f3",
      "command": "nks.search.findNext",
      "mac": "mod+g"
    },
    {
      "key": "shift+f3",
      "command": "nks.search.findPrevious",
      "mac": "mod+shift+g"
    },
    {
      "key": "ctrl+h",
      "command": "nks.search.replace",
      "mac": "mod+alt+f"
    },
    {
      "key": "ctrl+g",
      "command": "nks.search.gotoLine"
    },
    {
      "key": "mod+shift+p",
      "command": "nks.view.commandPalette"
    },
    {
      "key": "alt+z",
      "command": "nks.view.toggleWordWrap"
    },
    {
      "key": "mod+equal",
      "command": "nks.view.zoomIn"
    },
    {
      "key": "mod+minus",
      "command": "nks.view.zoomOut"
