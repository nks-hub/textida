<Project>
  <!--
    Import this file from every plugin project (and from the SDK): the plugin is published with NativeAOT, so
    - trimming and AOT analyzer findings fail the build instead of staying warnings,
    - the analyzer NKSPLG001 fails the build where the code uses reflection,
    - System.Text.Json refuses its reflection-based serializer at run time.
    The first and the last come from the props file of the public SDK package, which a plugin outside this repository gets with the package.
  -->
  <Import Project="$(MSBuildThisFileDirectory)..\NksHub.Textida.Plugin.Sdk\build\NksHub.Textida.Plugin.Sdk.props" />

  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\NksHub.Textida.PluginSdk.Analyzers\NksHub.Textida.PluginSdk.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>
