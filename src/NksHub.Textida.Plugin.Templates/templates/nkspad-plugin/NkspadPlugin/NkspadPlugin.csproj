<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- The editor runs a plugin as a native program: dotnet publish -c Release -r win-x64 (or osx-arm64, osx-x64) on the system you publish for. -->
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <!-- the package brings the analyzer NKSPLG001 (no reflection) and turns the trimming and AOT warnings into errors -->
    <PackageReference Include="NksHub.Textida.Plugin.Sdk" Version="SDK_VERSION" />
  </ItemGroup>

  <ItemGroup>
    <None Include="nkspad-plugin.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
