{
  "schemaVersion": 1,
  "id": "example.nkspad-plugin",
  "name": "NkspadPlugin",
  "version": "0.1.0",
  "api": { "min": 1, "max": 1 },
  "permissions": [ "document.read", "document.edit.direct" ],
  "main": {
    "executable": "./NkspadPlugin",
    "activationEvents": [ "onCommand:example.nkspad-plugin.shout" ]
  },
  "contributes": {
    "commands": [
      { "id": "example.nkspad-plugin.shout", "title": "Write the selection in capital letters", "undo": "transaction" }
    ]
  }
}
