<Project Sdk="Microsoft.NET.Sdk">

  <!-- A tiny managed library. Its built dll is embedded in the program so that the smoke test can open a real .NET assembly in the assembly viewer on every platform; nothing refers to its code. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
