<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);xUnit1051</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Headless.XUnit" Version="12.1.4" />
    <PackageReference Include="Avalonia.Skia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- In-process FTPS server for the remote file tests (MIT); test-only. -->
    <PackageReference Include="FubarDev.FtpServer" Version="3.1.2" />
    <PackageReference Include="FubarDev.FtpServer.FileSystem.DotNet" Version="3.1.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\Shared\ThreadPoolFloor.cs" Link="ThreadPoolFloor.cs" />
    <Compile Include="..\Shared\HugeText.cs" Link="HugeText.cs" />
    <Compile Include="..\Shared\TranscriptFile.cs" Link="TranscriptFile.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NksHub.Textida.App\NksHub.Textida.App.csproj" />
    <ProjectReference Include="..\..\src\NksHub.Textida.Remote\NksHub.Textida.Remote.csproj" />
    <Compile Include="..\NksHub.Textida.Remote.Tests\Servers\FtpsServer.cs" Link="Servers\FtpsServer.cs" />
    <Compile Include="..\NksHub.Textida.Remote.Tests\Servers\TestProxy.cs" Link="Servers\TestProxy.cs" />
    <Compile Include="..\NksHub.Textida.McpClient.Tests\FakeMcpHttpServer.cs" Link="Servers\FakeMcpHttpServer.cs" />
    <ProjectReference Include="..\NksHub.Textida.PluginHost.TestPlugin\NksHub.Textida.PluginHost.TestPlugin.csproj" />
    <ProjectReference Include="..\NksHub.Textida.ToolEcho\NksHub.Textida.ToolEcho.csproj" />
    <ProjectReference Include="..\..\src\NksHub.Textida.Plugins.Json\NksHub.Textida.Plugins.Json.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\NksHub.Textida.Plugins.TextTools\NksHub.Textida.Plugins.TextTools.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\NksHub.Textida.Plugins.WebData\NksHub.Textida.Plugins.WebData.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\NksHub.Textida.Plugins.CodeExplorer\NksHub.Textida.Plugins.CodeExplorer.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\NksHub.Textida.Plugins.Emmet\NksHub.Textida.Plugins.Emmet.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\NksHub.Textida.Plugins.Formatters\NksHub.Textida.Plugins.Formatters.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\NksHub.Textida.Plugins.Git\NksHub.Textida.Plugins.Git.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\NksHub.Textida.Plugins.Lsp\NksHub.Textida.Plugins.Lsp.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\..\src\NksHub.Textida.Plugins.Wiki\NksHub.Textida.Plugins.Wiki.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\NksHub.Textida.FakeLsp\NksHub.Textida.FakeLsp.csproj" />
    <ProjectReference Include="..\NksHub.Textida.FakeAcp\NksHub.Textida.FakeAcp.csproj" />
    <ProjectReference Include="..\..\src\NksHub.Textida.Mcp\NksHub.Textida.Mcp.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Target Name="CopyJsonPlugin" AfterTargets="Build">
    <ItemGroup>
      <JsonPluginFiles Include="..\..\src\NksHub.Textida.Plugins.Json\bin\$(Configuration)\$(TargetFramework)\**\*" />
      <TextToolsPluginFiles Include="..\..\src\NksHub.Textida.Plugins.TextTools\bin\$(Configuration)\$(TargetFramework)\**\*" />
      <WebDataPluginFiles Include="..\..\src\NksHub.Textida.Plugins.WebData\bin\$(Configuration)\$(TargetFramework)\**\*" />
      <CodeExplorerPluginFiles Include="..\..\src\NksHub.Textida.Plugins.CodeExplorer\bin\$(Configuration)\$(TargetFramework)\**\*" />
      <EmmetPluginFiles Include="..\..\src\NksHub.Textida.Plugins.Emmet\bin\$(Configuration)\$(TargetFramework)\**\*" />
      <FormattersPluginFiles Include="..\..\src\NksHub.Textida.Plugins.Formatters\bin\$(Configuration)\$(TargetFramework)\**\*" />
      <GitPluginFiles Include="..\..\src\NksHub.Textida.Plugins.Git\bin\$(Configuration)\$(TargetFramework)\**\*" />
      <LspPluginFiles Include="..\..\src\NksHub.Textida.Plugins.Lsp\bin\$(Configuration)\$(TargetFramework)\**\*" />
      <WikiPluginFiles Include="..\..\src\NksHub.Textida.Plugins.Wiki\bin\$(Configuration)\$(TargetFramework)\**\*" />
      <McpBridgeFiles Include="..\..\src\NksHub.Textida.Mcp\bin\$(Configuration)\$(TargetFramework)\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(JsonPluginFiles)" DestinationFiles="@(JsonPluginFiles->'$(OutDir)plugins\json\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(TextToolsPluginFiles)" DestinationFiles="@(TextToolsPluginFiles->'$(OutDir)plugins\texttools\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(WebDataPluginFiles)" DestinationFiles="@(WebDataPluginFiles->'$(OutDir)plugins\webdata\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(CodeExplorerPluginFiles)" DestinationFiles="@(CodeExplorerPluginFiles->'$(OutDir)plugins\codeexplorer\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(EmmetPluginFiles)" DestinationFiles="@(EmmetPluginFiles->'$(OutDir)plugins\emmet\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(FormattersPluginFiles)" DestinationFiles="@(FormattersPluginFiles->'$(OutDir)plugins\formatters\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(GitPluginFiles)" DestinationFiles="@(GitPluginFiles->'$(OutDir)plugins\git\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(LspPluginFiles)" DestinationFiles="@(LspPluginFiles->'$(OutDir)plugins\lsp\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(WikiPluginFiles)" DestinationFiles="@(WikiPluginFiles->'$(OutDir)plugins\wiki\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(McpBridgeFiles)" DestinationFiles="@(McpBridgeFiles->'$(OutDir)mcp\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>
</Project>
