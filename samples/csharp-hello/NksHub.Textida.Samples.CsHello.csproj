<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <PublishAot>true</PublishAot>
  </PropertyGroup>

  <Import Project="..\..\src\NksHub.Textida.PluginSdk\Plugin.props" />

  <ItemGroup>
    <ProjectReference Include="..\..\src\NksHub.Textida.Plugin.Sdk\NksHub.Textida.Plugin.Sdk.csproj" />
    <!-- inside this repository the connection layer is a project; the package carries it, so a plugin built on the package needs no reference -->
    <ProjectReference Include="..\..\src\NksHub.Textida.Rpc\NksHub.Textida.Rpc.csproj" />
  </ItemGroup>

</Project>
