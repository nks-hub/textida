{
  "schemaVersion": 1,
  "id": "example.python-hex",
  "name": "Python hex",
  "version": "1.0.0",
  "api": { "min": 1, "max": 1 },
  "permissions": ["hex.read"],
  "main": {
    "executable": "/path/to/python",
    "args": ["main.py"]
  },
  "contributes": {
    "hexDecoders": [{ "id": "bcd", "title": "BCD", "length": 1 }],
    "hexHashes": [{ "id": "blake2b-128", "title": "BLAKE2b-128" }],
    "hexExporters": [{ "id": "c-array", "title": "C array", "extension": ".c" }],
    "hexTemplates": [{ "id": "samples", "title": "Sample templates" }]
  }
}
